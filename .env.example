# Copy this file to .env (or .env.local) and fill in real values.
# See src/lib/env.ts for validation rules.

# MongoDB connection string — must include a database name and ?retryWrites=true&w=majority
DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority"

# Secret used to sign admin session JWTs — at least 32 random characters
# Generate one with: openssl rand -base64 32
JWT_SECRET=""

# Name of the cookie that stores the admin session JWT
JWT_COOKIE_NAME="admin_session"

# Vercel Blob storage token — create a Blob store in the Vercel dashboard's Storage tab
BLOB_READ_WRITE_TOKEN=""

# Resend (transactional email) API key and verified "from" address
RESEND_API_KEY=""
RESEND_FROM_EMAIL="orders@yourdomain.com"

# Public site URL (no trailing slash) — used for metadata, sitemap, canonical URLs
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
