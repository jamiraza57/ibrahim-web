generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mongodb"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

// ----------------------------------------------------------------------
// ADMIN / AUTH
// ----------------------------------------------------------------------

enum AdminRole {
  OWNER
  MANAGER
  STAFF
}

model AdminUser {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  email        String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(STAFF)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ----------------------------------------------------------------------
// CATALOG
// ----------------------------------------------------------------------

enum ProductStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
  HIDDEN
}

model Product {
  id               String        @id @default(auto()) @map("_id") @db.ObjectId
  name             String
  slug             String        @unique
  description      String
  shortDescription String?
  sku              String        @unique
  barcode          String?
  price            Float
  salePrice        Float?
  stock            Int           @default(0)
  weight           Float?
  dimensions       Json?
  material         String?
  purity           String?
  stone            String?
  color            String?
  videoUrl         String?

  status    ProductStatus @default(DRAFT)
  publishAt DateTime?

  isFeatured   Boolean @default(false)
  isNewArrival Boolean @default(false)
  isBestSeller Boolean @default(false)
  isTrending   Boolean @default(false)
  isOnSale     Boolean @default(false)

  metaTitle       String?
  metaDescription String?

  images      ProductImage[]
  categories  ProductCategory[]
  collections ProductCollection[]
  tags        ProductTag[]
  orderItems  OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([isFeatured])
  @@index([isNewArrival])
  @@index([isBestSeller])
}

model ProductImage {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  url         String
  alt         String?
  position    Int     @default(0)
  isThumbnail Boolean @default(false)

  productId String  @db.ObjectId
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Category {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  slug            String   @unique
  description     String?
  imageUrl        String?
  bannerUrl       String?
  order           Int      @default(0)
  status          Boolean  @default(true)
  metaTitle       String?
  metaDescription String?

  parentId String?    @db.ObjectId
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children Category[] @relation("CategoryTree")

  products ProductCategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
}

model Collection {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  slug            String   @unique
  description     String?
  bannerUrl       String?
  status          Boolean  @default(true)
  metaTitle       String?
  metaDescription String?

  products ProductCollection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tag {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  name String @unique
  slug String @unique

  products ProductTag[]
}

model ProductCategory {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  productId  String @db.ObjectId
  categoryId String @db.ObjectId
  position   Int    @default(0)

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([productId, categoryId])
  @@index([categoryId])
}

model ProductCollection {
  id           String @id @default(auto()) @map("_id") @db.ObjectId
  productId    String @db.ObjectId
  collectionId String @db.ObjectId
  position     Int    @default(0)

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([productId, collectionId])
  @@index([collectionId])
}

model ProductTag {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  productId String @db.ObjectId
  tagId     String @db.ObjectId

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([productId, tagId])
}

// ----------------------------------------------------------------------
// COMMERCE
// ----------------------------------------------------------------------

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  COD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Customer {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  name  String
  email String
  phone String

  addresses Address[]
  orders    Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email, phone])
}

model Address {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  line1      String
  line2      String?
  city       String
  state      String?
  postalCode String
  country    String  @default("PK")
  notes      String?

  customerId String   @db.ObjectId
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  orders Order[]

  @@index([customerId])
}

model Order {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  orderNumber String      @unique
  status      OrderStatus @default(PENDING)

  subtotal Float
  discount Float @default(0)
  shipping Float @default(0)
  total    Float

  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(PENDING)

  couponCode String?

  customerId String   @db.ObjectId
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  addressId String  @db.ObjectId
  address   Address @relation(fields: [addressId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  items   OrderItem[]
  history OrderStatusHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([customerId])
}

model OrderItem {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  name     String
  price    Float
  quantity Int
  image    String?

  orderId String @db.ObjectId
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String?  @db.ObjectId
  product   Product? @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([orderId])
}

model OrderStatusHistory {
  id        String      @id @default(auto()) @map("_id") @db.ObjectId
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  orderId String @db.ObjectId
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

enum CouponType {
  PERCENTAGE
  FIXED
}

model Coupon {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  code        String     @unique
  type        CouponType
  value       Float
  minPurchase Float?
  usageLimit  Int?
  usedCount   Int        @default(0)
  expiresAt   DateTime?
  isActive    Boolean    @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ----------------------------------------------------------------------
// CONTENT / SITE CONFIG
// ----------------------------------------------------------------------

enum AnnouncementType {
  SALE
  FLASH_SALE
  FREE_SHIPPING
  NEW_COLLECTION
}

model AnnouncementBar {
  id        String           @id @default(auto()) @map("_id") @db.ObjectId
  text      String
  isActive  Boolean          @default(false)
  bgColor   String           @default("#D4AF37")
  textColor String           @default("#050505")
  type      AnnouncementType @default(SALE)

  updatedAt DateTime @updatedAt
}

enum HomepageSectionType {
  HERO
  BANNER
  FEATURED_COLLECTIONS
  FEATURED_PRODUCTS
  TESTIMONIALS
  NEWSLETTER
  INSTAGRAM
  FOOTER
}

model HomepageSection {
  id        String              @id @default(auto()) @map("_id") @db.ObjectId
  type      HomepageSectionType
  order     Int                 @default(0)
  config    Json
  isVisible Boolean             @default(true)

  updatedAt DateTime @updatedAt

  @@index([order])
}

model MediaAsset {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  pathname String   @unique
  url      String
  folder   String?
  type     String
  createdAt DateTime @default(now())

  @@index([folder])
}

model NewsletterSubscriber {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  createdAt DateTime @default(now())
}

model Testimonial {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  avatarUrl String?
  rating    Int     @default(5)
  content   String
  isVisible Boolean @default(true)
  order     Int     @default(0)
}
